{
  "schema_version": 1,
  "service": "whenisbins-connector",
  "version": 2,
  "capabilities": [
    {
      "code": "read_collection_dates",
      "name": "Read your bin collection dates",
      "description": "Read collection dates for the synthetic home you choose. This connector checks Delegate; WhenIsBins itself has not installed Delegate.",
      "risk": "LOW",
      "requires_step_up": false,
      "minimum_assurance": "REGISTERED",
      "operation": {
        "method": "POST",
        "path": "/api/collections"
      },
      "supported_constraints": {
        "property_id": {
          "type": "enum",
          "values": [
            "home-sam",
            "home-other"
          ],
          "label": "Synthetic home"
        }
      }
    },
    {
      "code": "subscribe_reminders",
      "name": "Sign up for bin reminder emails",
      "description": "Use the unchanged synthetic website through a scoped browser adapter. A separate approval confirms the exact home and mailbox.",
      "risk": "MEDIUM",
      "requires_step_up": true,
      "minimum_assurance": "REGISTERED",
      "operation": {
        "method": "POST",
        "path": "/api/reminders/signup"
      },
      "approval_fields": [
        {
          "key": "property",
          "label": "Home",
          "required": true,
          "max": 160,
          "normalisation": "text"
        },
        {
          "key": "email",
          "label": "Email address",
          "required": true,
          "max": 160,
          "normalisation": "text"
        },
        {
          "key": "reminder_choice",
          "label": "Reminder time",
          "required": true,
          "max": 160,
          "normalisation": "text"
        }
      ],
      "supported_constraints": {
        "property_id": {
          "type": "enum",
          "values": [
            "home-sam"
          ],
          "label": "Synthetic home"
        },
        "mailbox_id": {
          "type": "enum",
          "values": [
            "mailbox-sam"
          ],
          "label": "Synthetic mailbox"
        }
      }
    },
    {
      "code": "cancel_reminders",
      "name": "Stop bin reminder emails",
      "description": "Use the unchanged synthetic website through a scoped browser adapter. A separate approval confirms the exact home and mailbox.",
      "risk": "MEDIUM",
      "requires_step_up": true,
      "minimum_assurance": "REGISTERED",
      "operation": {
        "method": "POST",
        "path": "/api/reminders/cancel"
      },
      "approval_fields": [
        {
          "key": "property",
          "label": "Home",
          "required": true,
          "max": 160,
          "normalisation": "text"
        },
        {
          "key": "email",
          "label": "Email address",
          "required": true,
          "max": 160,
          "normalisation": "text"
        },
        {
          "key": "reminder_choice",
          "label": "Reminder time",
          "required": true,
          "max": 160,
          "normalisation": "text"
        }
      ],
      "supported_constraints": {
        "property_id": {
          "type": "enum",
          "values": [
            "home-sam"
          ],
          "label": "Synthetic home"
        },
        "mailbox_id": {
          "type": "enum",
          "values": [
            "mailbox-sam"
          ],
          "label": "Synthetic mailbox"
        }
      }
    }
  ]
}
