{
  "name": "@prototype/hmrc",
  "version": "0.2.0",
  "private": true,
  "description": "Mock HMRC service (prototype): a One Login relying party that lets authorised agents through and adds friction for traffic that will not identify itself.",
  "scripts": {
    "sync-css": "node scripts/sync-css.mjs",
    "dev": "npm run sync-css && prisma generate && next dev -p 3302",
    "build": "npm run sync-css && prisma generate && next build",
    "start": "next start -p 3302",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@prisma/client": "^6.0.0",
    "jose": "^6.0.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
