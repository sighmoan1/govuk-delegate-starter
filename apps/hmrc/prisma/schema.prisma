generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// HMRC's own records. Nothing here is shared with Delegate: the One Login
// subject is the only key the two systems have in common.

model Taxpayer {
  id               String   @id @default(uuid())
  oneLoginSubject  String   @unique @map("one_login_subject")
  name             String
  taxCode          String   @map("tax_code")
  employer         String
  taxYear          String   @map("tax_year")
  createdAt        DateTime @default(now()) @map("created_at")

  claims Claim[]

  @@map("taxpayer")
}

enum ClaimStatus {
  OPEN
  CLOSED
}

enum SubmittedBy {
  SELF
  AGENT
}

model Claim {
  id          String      @id @default(uuid())
  taxpayerId  String      @map("taxpayer_id")
  reference   String      @unique
  kind        String // job_expenses | employment_update | refund_account | address
  summary     String
  newTaxCode  String?     @map("new_tax_code")
  submittedBy SubmittedBy @map("submitted_by")
  agentName   String?     @map("agent_name")
  createdAt   DateTime    @default(now()) @map("created_at")
  taxYear     String?     @map("tax_year")
  // A fingerprint of the evidence; a resubmission needs a different one.
  evidenceFingerprint String? @map("evidence_fingerprint")
  status      ClaimStatus @default(OPEN)
  mandateId   String?     @map("mandate_id")
  delegationId String?    @map("delegation_id")

  taxpayer Taxpayer     @relation(fields: [taxpayerId], references: [id])
  queries  ClaimQuery[]

  @@map("claim")
}

enum QueryStatus {
  OPEN
  ANSWERED
}

// HMRC asking for more information about a claim. An agent may only answer
// once the person has agreed the wording; HMRC records that they did.
model ClaimQuery {
  id                String      @id @default(uuid())
  claimId           String      @map("claim_id")
  question          String
  status            QueryStatus @default(OPEN)
  askedAt           DateTime    @default(now()) @map("asked_at")
  answer            String?
  answeredAt        DateTime?   @map("answered_at")
  answeredBy        SubmittedBy? @map("answered_by")
  answeredByName    String?     @map("answered_by_name")
  confirmedByPerson Boolean     @default(false) @map("confirmed_by_person")
  mandateId         String?     @map("mandate_id")
  delegationId      String?     @map("delegation_id")
  // GOV.UK Delegate's record of what the agent said the person agreed to.
  receiptId         String?     @map("receipt_id")
  answerWithdrawn   Boolean     @default(false) @map("answer_withdrawn")
  // Which submission of the answer this is; goes up when the person disputes one, so each gets its own receipt.
  answerVersion     Int         @default(0) @map("answer_version")

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("claim_query")
}

enum Lane {
  AUTHENTICATED_HUMAN
  AUTHORISED_AGENT
  DECLARED_AGENT // a known agent without authority: redirected to the proper route
  UNTRUSTED
}

enum Outcome {
  ALLOWED
  REFUSED
  THROTTLED
  CHALLENGED
}

// HMRC's own request log: every request to the service, whichever lane.
model ServiceEvent {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  lane        Lane
  outcome     Outcome
  reason      String?
  capability  String?
  path        String
  agentName   String?  @map("agent_name")
  agentId     String?  @map("agent_id")
  subject     String?
  latencyMs   Int      @map("latency_ms")
  delegateCheckId String? @map("delegate_check_id")
  // The chain, as Delegate reported it.
  mandateId          String?  @map("mandate_id")
  delegationId       String?  @map("delegation_id")
  parentDelegationId String?  @map("parent_delegation_id")
  depth              Int?
  agentLabel         String?  @map("agent_label")
  assurance          String?
  // Capacity against the person.
  rule               String?
  capacityUsed       Int?     @map("capacity_used")
  capacityLimit      Int?     @map("capacity_limit")
  // Evidence about who or what was on the other end.
  userAgent          String?  @map("user_agent")
  signatureAgent     String?  @map("signature_agent")
  signatureResult    String?  @map("signature_result")
  automationSignals  Json?    @map("automation_signals")
  sessionId          String?  @map("session_id")
  runTag             String?  @map("run_tag")

  @@index([timestamp])
  @@map("service_event")
}

// Use of a rate-limited rule by a person (One Login subject), whoever acted.
model PrincipalUsage {
  id      String   @id @default(uuid())
  subject String
  rule    String
  at      DateTime @default(now())

  @@index([subject, rule, at])
  @@map("principal_usage")
}
