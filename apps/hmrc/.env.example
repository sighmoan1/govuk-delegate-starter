# Copy to .env for `npm run dev` (docker compose up -d db simulator first).
DATABASE_URL=postgresql://delegate:delegate@localhost:5433/hmrc
APP_URL=http://localhost:3302
OIDC_ISSUER=http://localhost:3301
OIDC_INTERNAL_URL=http://localhost:3399
# The simulator supports one client; in production HMRC would be its own relying party.
OIDC_CLIENT_ID=delegate-dev-client
OIDC_PRIVATE_KEY_FILE=../../dev/oidc-client-private.pem
SESSION_SECRET=dev-only-hmrc-session-secret-change-me-0123456789
# What HMRC got when it registered with GOV.UK Delegate.
DELEGATE_URL=http://localhost:3300
DELEGATE_INTERNAL_URL=http://localhost:3300
DELEGATE_SERVICE_SLUG=hmrc-personal-tax
HMRC_SERVICE_KEY=dev-hmrc-service-key
ABOUT_URL=http://localhost:3304
# The queue worker (`npm run worker -w apps/hmrc`); all optional, these are the defaults.
# HMRC_QUEUE_CONCURRENCY=4          items one worker process handles at once
# HMRC_QUEUE_LEASE_SECONDS=60       how long a worker may hold an item before another may take it
# HMRC_QUEUE_MAX_ATTEMPTS=5         attempts before an item is FAILED
# HMRC_QUEUE_BACKOFF_SECONDS=5      first retry delay; doubles each attempt
# HMRC_QUEUE_BACKOFF_CAP_SECONDS=300
# HMRC_QUEUE_POLL_MS=1000           how often an idle worker looks for work
