# Copy to .env for `npm run dev` (docker compose up -d db simulator first; Delegate and HMRC running).
DATABASE_URL=postgresql://delegate:delegate@localhost:5433/agent
APP_URL=http://localhost:3303
# What Example AI got when it registered with GOV.UK Delegate.
DELEGATE_URL=http://localhost:3300
DELEGATE_INTERNAL_URL=http://localhost:3300
AGENT_CLIENT_ID=demo-personal-agent
AGENT_CLIENT_SECRET=dev-demo-agent-secret
# The service it acts with.
HMRC_URL=http://localhost:3302
HMRC_INTERNAL_URL=http://localhost:3302
