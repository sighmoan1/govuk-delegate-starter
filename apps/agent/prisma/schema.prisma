generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Example AI's own records: Sam's conversation, and its connection to HMRC.
// The only thing it ever learns about Sam from government is an opaque id.

enum Role {
  USER
  ASSISTANT
}

model Message {
  id        String   @id @default(uuid())
  seq       Int      @default(autoincrement())
  role      Role
  text      String
  // Optional card under the message, e.g. { type: "connect", url, requestId, capabilities }.
  card      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("message")
}

model Connection {
  id               String   @id // "hmrc"
  principalId      String?  @map("principal_id")
  granted          String[]
  pendingRequestId String?  @map("pending_request_id")
  pendingIntent    String?  @map("pending_intent")
  connectedAt      DateTime? @map("connected_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("connection")
}
