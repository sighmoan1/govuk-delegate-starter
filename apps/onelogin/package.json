{
  "name": "@prototype/onelogin",
  "version": "0.2.0",
  "private": true,
  "description": "A GOV.UK One Login-style sign-in in front of the official One Login simulator.",
  "scripts": {
    "sync-css": "node scripts/sync-css.mjs",
    "dev": "npm run sync-css && next dev -p 3301",
    "build": "npm run sync-css && next build",
    "start": "next start -p 3301",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@prototype/web-bot-auth": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
