generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Scaffold only. No citizen identifiers, raw events, feeds or predictions.
model ResearchWorkspace {
  id              String   @id
  protocolVersion String   @map("protocol_version")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("research_workspace")
}

// Append-only minimised source snapshots. No ground-truth labels here.
model ObservedEvent {
  id            String   @id @default(uuid())
  sourceService String   @map("source_service")
  sourceEventId String   @map("source_event_id")
  schemaVersion Int      @map("schema_version")
  occurredAt    DateTime @map("occurred_at")
  receivedAt    DateTime @default(now()) @map("received_at")
  snapshot      Json

  @@unique([sourceService, sourceEventId])
  @@map("observed_event")
}

model FeedCursor {
  sourceService String   @id @map("source_service")
  cursor        String?
  generation    Int      @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("feed_cursor")
}

// Evaluation-only truth. Never join these fields into ObservedEvent snapshots.
model ResearchRun {
  id              String   @id
  mode            String
  status          String   @default("OPEN")
  protocolVersion String   @map("protocol_version")
  sourceCommit    String   @map("source_commit")
  seed            String
  studyOwner      String   @map("study_owner")
  evidenceDigest  String?  @unique @map("evidence_digest")
  createdAt       DateTime @default(now()) @map("created_at")
  attempts        ResearchAttempt[]
  @@map("research_run")
}

model ResearchAttempt {
  id             String   @id
  runId          String   @map("run_id")
  intentId       String   @map("intent_id")
  status         String
  executionClass String?  @map("execution_class")
  provenance     Json?
  createdAt      DateTime @default(now()) @map("created_at")
  verifiedAt     DateTime? @map("verified_at")
  run            ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  bindings       ResearchBinding[]
  enrolments     ResearchEnrolment[]
  sessions       ResearchSession[]
  @@index([runId])
  @@map("research_attempt")
}

model ResearchBinding {
  id            String @id
  attemptId     String @map("attempt_id")
  sourceService String @map("source_service")
  sourceEventId String @map("source_event_id")
  operationId   String? @map("operation_id")
  eventKind String @map("event_kind")
  effectClass   String @map("effect_class")
  effectEvidenceDigest String? @map("effect_evidence_digest")
  identityObservation Json @map("identity_observation")
  attempt       ResearchAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@unique([sourceService, sourceEventId])
  @@map("research_binding")
}

model ResearchEnrolment {
  id        String @id
  attemptId String @map("attempt_id")
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  claimedAt DateTime? @map("claimed_at")
  attempt   ResearchAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@map("research_enrolment")
}

model ResearchSession {
  id        String @id
  attemptId String @map("attempt_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  attempt   ResearchAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@map("research_session")
}

// Blind inference storage. No relation to protected execution truth.
model EvidenceSnapshot {
  id String @id @default(uuid())
  sourceService String @map("source_service")
  sourceEventId String @map("source_event_id")
  schemaVersion String @map("schema_version")
  digest String @unique
  record Json
  createdAt DateTime @default(now()) @map("created_at")
  runs ClassificationRun[]
  @@unique([sourceService, sourceEventId, schemaVersion])
  @@map("evidence_snapshot")
}
model ClassifierConfig {
  id String @id @default(uuid())
  digest String @unique
  record Json
  createdAt DateTime @default(now()) @map("created_at")
  runs ClassificationRun[]
  @@map("classifier_config")
}
model ClassificationRun {
  id String @id @default(uuid())
  snapshotId String @map("snapshot_id")
  configId String @map("config_id")
  result Json
  createdAt DateTime @default(now()) @map("created_at")
  snapshot EvidenceSnapshot @relation(fields: [snapshotId], references: [id])
  config ClassifierConfig @relation(fields: [configId], references: [id])
  @@index([snapshotId, createdAt])
  @@map("classification_run")
}

// Evaluator-only frozen synthetic corpus/configuration/report. Never fed to inference.
model ExperimentAnalysis {
  id String @id @default(uuid())
  corpusDigest String @map("corpus_digest")
  configDigest String @map("config_digest")
  corpus Json
  report Json
  createdAt DateTime @default(now()) @map("created_at")
  @@index([createdAt])
  @@map("experiment_analysis")
}

// Durable accounting only; no labels, prompts, credentials or vendor payloads.
model DetectorQuota {
  id String @id
  calls Int
  reservedMicroUsd BigInt @map("reserved_micro_usd")
  nextAllowedAt DateTime @map("next_allowed_at")
  @@map("detector_quota")
}
