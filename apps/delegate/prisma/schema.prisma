generator client {
  provider = "prisma-client-js"
  // Each app generates its own client: three schemas cannot share the hoisted default.
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DelegateType {
  PERSON
  ORGANISATION
  SOFTWARE_AGENT
}

enum DelegateStatus {
  ACTIVE
  SUSPENDED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum AuthorisationStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum Decision {
  ALLOW
  DENY
}

enum Lane {
  AUTHENTICATED_HUMAN
  AUTHORISED_AGENT
  UNTRUSTED
}

enum Reason {
  VALID_AUTHORISATION
  PERMISSION_MISSING
  AUTHORISATION_REVOKED
  AUTHORISATION_EXPIRED
  UNKNOWN_DELEGATE
  INVALID_AGENT_AUTHENTICATION
  NO_AUTHORISATION
  RATE_LIMITED
  HUMAN_SESSION
}

model Principal {
  id                 String   @id @default(uuid())
  oneLoginSubjectId  String   @unique @map("one_login_subject_id")
  displayName        String   @map("display_name")
  createdAt          DateTime @default(now()) @map("created_at")

  requests       AuthorisationRequest[]
  authorisations Authorisation[]
  events         ActivityEvent[]

  @@map("principal")
}

model Delegate {
  id               String         @id @default(uuid())
  name             String
  type             DelegateType
  provider         String
  clientId         String         @unique @map("client_id")
  clientSecretHash String         @map("client_secret_hash")
  status           DelegateStatus @default(ACTIVE)
  // Registered return URLs, as for an OAuth client.
  redirectUris     String[]       @map("redirect_uris")
  createdAt        DateTime       @default(now()) @map("created_at")

  requests       AuthorisationRequest[]
  authorisations Authorisation[]
  events         ActivityEvent[]

  @@map("delegate")
}

model Service {
  id   String @id @default(uuid())
  name String
  slug String @unique

  capabilities   Capability[]
  requests       AuthorisationRequest[]
  authorisations Authorisation[]
  events         ActivityEvent[]

  @@map("service")
}

model Capability {
  id              String    @id @default(uuid())
  serviceId       String    @map("service_id")
  code            String
  name            String
  riskLevel       RiskLevel @map("risk_level")
  requiresStepUp  Boolean   @default(false) @map("requires_step_up")
  sortOrder       Int       @default(0) @map("sort_order")

  service Service @relation(fields: [serviceId], references: [id])
  requestPermissions AuthorisationRequestPermission[]
  authorisationPermissions AuthorisationPermission[]

  @@unique([serviceId, code])
  @@map("capability")
}

model AuthorisationRequest {
  id              String        @id @default(uuid())
  principalHint   String?       @map("principal_hint")
  principalId     String?       @map("principal_id")
  delegateId      String        @map("delegate_id")
  serviceId       String        @map("service_id")
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")
  expiresAt       DateTime      @map("expires_at")
  respondedAt     DateTime?     @map("responded_at")
  authorisationId String?       @unique @map("authorisation_id")
  returnUrl       String?       @map("return_url")

  principal     Principal? @relation(fields: [principalId], references: [id])
  delegate      Delegate   @relation(fields: [delegateId], references: [id])
  service       Service    @relation(fields: [serviceId], references: [id])
  authorisation Authorisation? @relation(fields: [authorisationId], references: [id])
  permissions   AuthorisationRequestPermission[]

  @@map("authorisation_request")
}

model AuthorisationRequestPermission {
  authorisationRequestId String @map("authorisation_request_id")
  capabilityId           String @map("capability_id")

  request    AuthorisationRequest @relation(fields: [authorisationRequestId], references: [id], onDelete: Cascade)
  capability Capability           @relation(fields: [capabilityId], references: [id])

  @@id([authorisationRequestId, capabilityId])
  @@map("authorisation_request_permission")
}

model Authorisation {
  id         String              @id @default(uuid())
  principalId String             @map("principal_id")
  delegateId String              @map("delegate_id")
  serviceId  String              @map("service_id")
  status     AuthorisationStatus @default(ACTIVE)
  validFrom  DateTime            @default(now()) @map("valid_from")
  validUntil DateTime            @map("valid_until")
  createdAt  DateTime            @default(now()) @map("created_at")
  revokedAt  DateTime?           @map("revoked_at")

  principal   Principal @relation(fields: [principalId], references: [id])
  delegate    Delegate  @relation(fields: [delegateId], references: [id])
  service     Service   @relation(fields: [serviceId], references: [id])
  permissions AuthorisationPermission[]
  request     AuthorisationRequest?
  events      ActivityEvent[]

  @@index([principalId, delegateId, serviceId])
  @@map("authorisation")
}

model AuthorisationPermission {
  authorisationId String @map("authorisation_id")
  capabilityId    String @map("capability_id")

  authorisation Authorisation @relation(fields: [authorisationId], references: [id], onDelete: Cascade)
  capability    Capability    @relation(fields: [capabilityId], references: [id])

  @@id([authorisationId, capabilityId])
  @@map("authorisation_permission")
}

model ActivityEvent {
  id              String    @id @default(uuid())
  timestamp       DateTime  @default(now())
  lane            Lane
  principalId     String?   @map("principal_id")
  delegateId      String?   @map("delegate_id")
  authorisationId String?   @map("authorisation_id")
  serviceId       String?   @map("service_id")
  // What the caller asked for / presented, kept even when it matched nothing.
  capability      String?
  presentedClientId String? @map("presented_client_id")
  decision        Decision
  reason          Reason
  requestId       String    @map("request_id")

  principal     Principal?     @relation(fields: [principalId], references: [id])
  delegate      Delegate?      @relation(fields: [delegateId], references: [id])
  authorisation Authorisation? @relation(fields: [authorisationId], references: [id])
  service       Service?       @relation(fields: [serviceId], references: [id])

  @@index([timestamp])
  @@map("activity_event")
}

// Agent-side storage: belongs to "Example AI", not to Delegate. It only ever
// learns the principal's id from an approved authorisation request.
model AgentConversation {
  id               String   @id @default(uuid())
  messages         Json     @default("[]")
  principalId      String?  @map("principal_id")
  pendingRequestId String?  @map("pending_request_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("agent_conversation")
}
