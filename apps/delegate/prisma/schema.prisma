generator client {
  provider = "prisma-client-js"
  // Each app generates its own client: three schemas cannot share the hoisted default.
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DelegateType {
  PERSON
  ORGANISATION
  SOFTWARE_AGENT
}

enum DelegateStatus {
  ACTIVE
  SUSPENDED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum AuthorisationStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum Decision {
  ALLOW
  DENY
}

enum Lane {
  AUTHENTICATED_HUMAN
  AUTHORISED_AGENT
  UNTRUSTED
}

enum Reason {
  VALID_AUTHORISATION
  PERMISSION_MISSING
  AUTHORISATION_REVOKED
  AUTHORISATION_EXPIRED
  UNKNOWN_DELEGATE
  INVALID_AGENT_AUTHENTICATION
  NO_AUTHORISATION
  RATE_LIMITED
  HUMAN_SESSION
  CAPACITY_EXCEEDED // legacy: kept so old activity rows read; Delegate no longer issues it
  STEP_UP_REQUIRED
  DELEGATION_DEPTH_EXCEEDED
  ASSURANCE_TOO_LOW
}

// How sure Delegate is about who the agent is.
enum Assurance {
  VERIFIED    // Web Bot Auth signature from a trusted key directory
  REGISTERED  // client credentials issued by Delegate
  DECLARED    // self-asserted by an agent in someone's browser
}

enum IdentityType {
  CLIENT_CREDENTIALS
  WEB_BOT_AUTH
  DECLARED
}

enum DelegationStatus {
  ACTIVE
  REVOKED
}

enum StepUpStatus {
  PENDING // proposed by the service on the agent's behalf; the person has not decided
  APPROVED // the person approved this exact proposal; nothing has been redeemed
  RESERVED // a service holds the approval for one in-flight operation (a lease, not a spend)
  USED // the service reported the operation committed; spent for good
  DECLINED // the person said no to this exact proposal
  EXPIRED // the validity window ran out before it was used
}

model Principal {
  id                 String   @id @default(uuid())
  oneLoginSubjectId  String   @unique @map("one_login_subject_id")
  displayName        String   @map("display_name")
  createdAt          DateTime @default(now()) @map("created_at")

  requests       AuthorisationRequest[]
  authorisations Authorisation[]
  events         ActivityEvent[]

  @@map("principal")
}

model Delegate {
  id               String         @id @default(uuid())
  name             String
  type             DelegateType
  provider         String
  clientId         String         @unique @map("client_id")
  clientSecretHash String         @map("client_secret_hash")
  status           DelegateStatus @default(ACTIVE)
  identityType     IdentityType   @default(CLIENT_CREDENTIALS) @map("identity_type")
  // For agents identified by Web Bot Auth, e.g. "https://chatgpt.com".
  webBotAuthAgent  String?        @unique @map("web_bot_auth_agent")
  // Registered return URLs, as for an OAuth client.
  redirectUris     String[]       @map("redirect_uris")
  createdAt        DateTime       @default(now()) @map("created_at")

  requests       AuthorisationRequest[]
  authorisations Authorisation[]
  delegations    Delegation[]
  events         ActivityEvent[]

  @@map("delegate")
}

// A government service registered with Delegate once. It authenticates to the
// check API with its own key, so neither a person's nor an agent's credential.
model Service {
  id         String @id @default(uuid())
  name       String
  slug       String @unique
  apiKeyHash String @map("api_key_hash")

  capabilities   Capability[]
  requests       AuthorisationRequest[]
  authorisations Authorisation[]
  events         ActivityEvent[]

  @@map("service")
}

model Capability {
  id              String    @id @default(uuid())
  serviceId       String    @map("service_id")
  code            String
  name            String
  riskLevel       RiskLevel @map("risk_level")
  requiresStepUp  Boolean   @default(false) @map("requires_step_up")
  sortOrder       Int       @default(0) @map("sort_order")

  service Service @relation(fields: [serviceId], references: [id])
  requestPermissions AuthorisationRequestPermission[]
  authorisationPermissions AuthorisationPermission[]

  @@unique([serviceId, code])
  @@map("capability")
}

model AuthorisationRequest {
  id              String        @id @default(uuid())
  principalHint   String?       @map("principal_hint")
  principalId     String?       @map("principal_id")
  delegateId      String        @map("delegate_id")
  serviceId       String        @map("service_id")
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")
  expiresAt       DateTime      @map("expires_at")
  respondedAt     DateTime?     @map("responded_at")
  authorisationId String?       @unique @map("authorisation_id")
  returnUrl       String?       @map("return_url")
  // Device-code style: an agent at a service shows the person this code, and
  // the person approves on GOV.UK in their own browser.
  userCode        String?       @unique @map("user_code")
  initiatedByServiceId String?  @map("initiated_by_service_id")
  requestedAssurance Assurance? @map("requested_assurance")

  principal     Principal? @relation(fields: [principalId], references: [id])
  delegate      Delegate   @relation(fields: [delegateId], references: [id])
  service       Service    @relation(fields: [serviceId], references: [id])
  authorisation Authorisation? @relation(fields: [authorisationId], references: [id])
  permissions   AuthorisationRequestPermission[]

  @@map("authorisation_request")
}

model AuthorisationRequestPermission {
  authorisationRequestId String @map("authorisation_request_id")
  capabilityId           String @map("capability_id")

  request    AuthorisationRequest @relation(fields: [authorisationRequestId], references: [id], onDelete: Cascade)
  capability Capability           @relation(fields: [capabilityId], references: [id])

  @@id([authorisationRequestId, capabilityId])
  @@map("authorisation_request_permission")
}

model Authorisation {
  id         String              @id @default(uuid())
  principalId String             @map("principal_id")
  delegateId String              @map("delegate_id")
  serviceId  String              @map("service_id")
  status     AuthorisationStatus @default(ACTIVE)
  validFrom  DateTime            @default(now()) @map("valid_from")
  validUntil DateTime            @map("valid_until")
  createdAt  DateTime            @default(now()) @map("created_at")
  revokedAt  DateTime?           @map("revoked_at")
  // How far agents may pass this authority on to sub-agents.
  maxDepth   Int                 @default(2) @map("max_depth")

  principal   Principal @relation(fields: [principalId], references: [id])
  delegate    Delegate  @relation(fields: [delegateId], references: [id])
  service     Service   @relation(fields: [serviceId], references: [id])
  permissions AuthorisationPermission[]
  request     AuthorisationRequest?
  delegations Delegation[]
  stepUps     StepUp[]
  events      ActivityEvent[]

  @@index([principalId, delegateId, serviceId])
  @@map("authorisation")
}

model AuthorisationPermission {
  authorisationId String @map("authorisation_id")
  capabilityId    String @map("capability_id")

  authorisation Authorisation @relation(fields: [authorisationId], references: [id], onDelete: Cascade)
  capability    Capability    @relation(fields: [capabilityId], references: [id])

  @@id([authorisationId, capabilityId])
  @@map("authorisation_permission")
}

// What actually happened after an authority check said yes. A check is not an
// outcome: the service reports these back, tied to the check by checkId.
enum OutcomeStatus {
  SUBMITTED
  ACCEPTED
  FAILED
  COMPLETED
}

model ActivityEvent {
  id              String    @id @default(uuid())
  timestamp       DateTime  @default(now())
  lane            Lane
  principalId     String?   @map("principal_id")
  delegateId      String?   @map("delegate_id")
  authorisationId String?   @map("authorisation_id")
  serviceId       String?   @map("service_id")
  // What the caller asked for / presented, kept even when it matched nothing.
  capability      String?
  presentedClientId String? @map("presented_client_id")
  decision        Decision
  reason          Reason
  requestId       String    @map("request_id")
  // The chain: root principal → mandate (authorisationId) → delegation.
  delegationId       String?  @map("delegation_id")
  parentDelegationId String?  @map("parent_delegation_id")
  depth              Int?
  assurance          Assurance?

  principal     Principal?     @relation(fields: [principalId], references: [id])
  delegate      Delegate?      @relation(fields: [delegateId], references: [id])
  authorisation Authorisation? @relation(fields: [authorisationId], references: [id])
  service       Service?       @relation(fields: [serviceId], references: [id])

  @@index([timestamp])
  @@map("activity_event")
}

// A place in the chain of authority. The agent the person approved is the
// root (depth 0); agents may pass a subset of their authority to sub-agents.
// Every delegation inherits the mandate, and so the root principal.
model Delegation {
  id                 String           @id @default(uuid())
  mandateId          String           @map("mandate_id")
  delegateId         String           @map("delegate_id")
  parentDelegationId String?          @map("parent_delegation_id")
  depth              Int
  label              String?          // e.g. "worker 17", for a sub-agent instance
  capabilities       String[]
  assurance          Assurance
  status             DelegationStatus @default(ACTIVE)
  createdAt          DateTime         @default(now()) @map("created_at")

  mandate  Authorisation @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  delegate Delegate      @relation(fields: [delegateId], references: [id])
  parent   Delegation?   @relation("DelegationTree", fields: [parentDelegationId], references: [id])
  children Delegation[]  @relation("DelegationTree")

  @@index([mandateId])
  @@map("delegation")
}

// The person's approval of ONE proposed consequential transaction (issue #19).
// It is bound to the mandate, principal, service, capability, a digest of the
// proposed content and the client's idempotency key, and it expires. Checking
// never changes it. The service reserves it when it admits the operation and
// completes it after its own commit (docs/DECISIONS.md, Decision 24).
model StepUp {
  id             String       @id @default(uuid())
  mandateId      String       @map("mandate_id")
  principalId    String       @map("principal_id")
  serviceId      String       @map("service_id")
  capability     String
  userCode       String       @unique @map("user_code")
  idempotencyKey String       @map("idempotency_key")
  payloadDigest  String       @map("payload_digest") // sha256 over service + capability + normalised content
  proposalHash   String       @map("proposal_hash") // sha256 over every binding field, including expiry
  display        Json         // what the person is shown: [{ label, value }], sensitive values masked
  status         StepUpStatus @default(PENDING)
  createdAt      DateTime     @default(now()) @map("created_at")
  expiresAt      DateTime     @map("expires_at")
  approvedAt     DateTime?    @map("approved_at")
  declinedAt     DateTime?    @map("declined_at")
  reservationId  String?      @map("reservation_id")
  reservedAt     DateTime?    @map("reserved_at")
  reservationExpiresAt DateTime? @map("reservation_expires_at")
  usedAt         DateTime?    @map("used_at")
  usedReference  String?      @map("used_reference") // the service's own reference for what it committed

  mandate Authorisation @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  // Also: a partial unique index (one non-expired proposal per mandate + capability + key + digest) lives in SQL only.
  @@index([mandateId, capability, idempotencyKey])
  @@map("step_up")
}

enum ReceiptStatus {
  RECORDED
  DISPUTED
}

// What a service says an agent did in the person's name, with the exact words,
// so the person can see it and say "I didn't agree to that".
model Receipt {
  id             String        @id @default(uuid())
  principalId    String        @map("principal_id")
  mandateId      String        @map("mandate_id")
  delegationId   String?       @map("delegation_id")
  delegateId     String        @map("delegate_id")
  serviceId      String        @map("service_id")
  capability     String
  reference      String
  text           String
  agentConfirmed Boolean       @map("agent_confirmed")
  // Stable key from the service (service + query + submission version), so a retried write returns the same receipt.
  idempotencyKey String?       @unique @map("idempotency_key")
  status         ReceiptStatus @default(RECORDED)
  createdAt      DateTime      @default(now()) @map("created_at")
  seenAt         DateTime?     @map("seen_at")
  disputedAt     DateTime?     @map("disputed_at")

  @@index([principalId, createdAt])
  @@index([mandateId])
  @@map("receipt")
}

// Append-only history of outcomes a service reports for an ALLOW check.
// (serviceId, idempotencyKey) is unique, so repeat delivery adds nothing.
model TransactionOutcome {
  id             String        @id @default(uuid())
  idempotencyKey String        @map("idempotency_key")
  checkId        String        @map("check_id")
  principalId    String        @map("principal_id")
  mandateId      String        @map("mandate_id")
  delegationId   String?       @map("delegation_id")
  delegateId     String        @map("delegate_id")
  serviceId      String        @map("service_id")
  capability     String
  status         OutcomeStatus
  reference      String?
  reason         String?
  occurredAt     DateTime      @map("occurred_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@unique([serviceId, idempotencyKey])
  @@index([checkId])
  @@index([mandateId, occurredAt])
  @@map("transaction_outcome")
}
