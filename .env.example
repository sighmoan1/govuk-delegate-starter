# Copy to .env for `npm run dev` (docker compose up db simulator first).
DATABASE_URL=postgresql://delegate:delegate@localhost:5433/delegate
APP_URL=http://localhost:3300
OIDC_ISSUER=http://localhost:3301
OIDC_INTERNAL_URL=http://localhost:3301
OIDC_CLIENT_ID=delegate-dev-client
OIDC_PRIVATE_KEY_FILE=dev/oidc-client-private.pem
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
AGENT_TOKEN_SECRET=dev-only-agent-token-secret-change-me-0123456789
DEMO_AGENT_CLIENT_ID=demo-personal-agent
DEMO_AGENT_CLIENT_SECRET=dev-demo-agent-secret
DWP_SERVICE_KEY=dev-dwp-service-key
DELEGATE_BASE_URL=http://localhost:3300
