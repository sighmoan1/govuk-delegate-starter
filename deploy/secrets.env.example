# Store on the server ONLY at /srv/bathos/secrets/delegate-demo.env (mode 0600).
# Do not commit actual secrets. URL-encode database password characters as needed.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
DELEGATE_DATABASE_URL=postgresql://delegate:CHANGE_ME_LONG_RANDOM@db:5432/delegate
HMRC_DATABASE_URL=postgresql://delegate:CHANGE_ME_LONG_RANDOM@db:5432/hmrc
# Observatory disabled by default. Its initialization password is currently dev-only.
OBSERVATORY_DATABASE_URL=postgresql://observatory:observatory@db:5432/observatory
DELEGATE_PUBLIC_URL=https://delegate-demo.bathos.org
HMRC_PUBLIC_URL=https://hmrc-demo.bathos.org
ONELOGIN_PUBLIC_URL=https://login-demo.bathos.org
ABOUT_PUBLIC_URL=https://about-demo.bathos.org
ONELOGIN_DEMO_PASSWORD=CHANGE_ME_LONG_RANDOM
DEMO_CONSOLE_KEY=CHANGE_ME_LONG_RANDOM
DELEGATE_SESSION_SECRET=CHANGE_ME_LONG_RANDOM
HMRC_SESSION_SECRET=CHANGE_ME_LONG_RANDOM
AGENT_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM
AGENT_CLIENT_SECRET=CHANGE_ME_LONG_RANDOM
HMRC_SERVICE_KEY=CHANGE_ME_LONG_RANDOM
COUNCIL_SERVICE_KEY=CHANGE_ME_LONG_RANDOM
# The Cloudflare named tunnel should direct service hostnames to the shared edge.
